# ---------------------------------------------------------------------------
# Local development (Docker / native Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cdri_ehr
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# ---------------------------------------------------------------------------
# Managed Postgres (Vercel Postgres / Neon / Supabase / RDS)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
#
# TLS is enabled automatically for any non-localhost host
# (ssl: { rejectUnauthorized: false }). Force it on/off with PGSSL=true|false.
#
# For `npm run db:migrate` use the DIRECT (non-pooled) connection string if your
# provider gives one — transaction poolers (PgBouncer, Neon `-pooler` host) can
# reject multi-statement DDL. Switch back to the pooled URL for the running API.
#
# CORS_ORIGIN accepts a comma-separated list; unset = allow all origins.
